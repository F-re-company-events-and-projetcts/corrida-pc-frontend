generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id            String         @id @default(cuid())
  nome          String
  percursoKm    Int
  tipo          TipoCategoria
  vagasTotal    Int            @default(150)
  vagasOcupadas Int            @default(0)
  createdAt     DateTime       @default(now())
  participantes Participante[]
}

model Lote {
  id           String   @id @default(cuid())
  nome         String
  precoCidadao Float
  ativo        Boolean  @default(false)
  dataInicio   DateTime
  dataFim      DateTime
  createdAt    DateTime @default(now())
}

model Pedido {
  id              String          @id @default(cuid())
  numeroPedidoSeq Int             @unique @default(autoincrement())
  numeroPedido    String          @unique @default(dbgenerated())
  total           Float
  status          StatusPedido    @default(AGUARDANDO_PAGAMENTO)
  metodoPagamento MetodoPagamento
  paymentId       String?         @unique
  expiresAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  pagamento       Pagamento?
  participantes   Participante[]
  rascunho        PedidoRascunho?
}

model PedidoRascunho {
  id             String   @id @default(cuid())
  pedidoId       String   @unique
  inscricoesJson String
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  pedido         Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
}

model Participante {
  id                 String          @id @default(cuid())
  nome               String
  cpf                String
  cpfCriptografado   String?
  dataNascimento     DateTime
  telefone           String
  email              String
  contatoEmergencia  String
  sexo               Sexo
  grupoCorrida      String?
  tamanhoCamiseta    TamanhoCamiseta
  categoriaId        String
  pedidoId           String
  numeroPeito        Int?
  checkinRealizadoEm DateTime?
  createdAt          DateTime        @default(now())
  categoria          Categoria       @relation(fields: [categoriaId], references: [id])
  pedido             Pedido          @relation(fields: [pedidoId], references: [id])

  @@index([cpf])
  @@index([email])
  @@index([categoriaId])
}

model Pagamento {
  id                String          @id @default(cuid())
  pedidoId          String          @unique
  paymentIdGateway  String          @unique
  valor             Float
  metodo            MetodoPagamento
  status            String
  webhookRecebidoEm DateTime?
  createdAt         DateTime        @default(now())
  pedido            Pedido          @relation(fields: [pedidoId], references: [id])
}

model AdminUser {
  id        String     @id @default(cuid())
  email     String     @unique
  senha     String
  nome      String
  role      AdminRole  @default(OPERACIONAL)
  createdAt DateTime   @default(now())
  logs      AdminLog[]
}

model Configuracao {
  chave     String   @id
  valor     String
  updatedAt DateTime @updatedAt
}

model AdminLog {
  id            String    @id @default(cuid())
  adminId       String
  acao          String
  entidade      String
  entidadeId    String
  valorAnterior String?
  valorNovo     String?
  createdAt     DateTime  @default(now())
  admin         AdminUser @relation(fields: [adminId], references: [id])
}

enum TipoCategoria {
  CIDADAO
  POLICIAL
}

enum StatusPedido {
  AGUARDANDO_PAGAMENTO
  PAGO
  RECUSADO
  EXPIRADO
  CANCELADO
}

enum MetodoPagamento {
  PIX
  CARTAO
}

enum Sexo {
  MASCULINO
  FEMININO
  OUTRO
}

enum TamanhoCamiseta {
  PP
  P
  M
  G
  GG
  XGG
}

enum AdminRole {
  TOTAL
  OPERACIONAL
}
